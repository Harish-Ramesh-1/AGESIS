VITE_API_BASE_URL=http://localhost:4000/api
VITE_PUBLIC_SITE_URL=https://www.agesisschool.edu
VITE_SUPPORT_EMAIL=support@agesisschool.edu
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# A real backend lives in ../BACKEND — run it (see its README) and leave this
# "false" to use it. The seeded demo accounts (P-12345 / ACC1023 / ADM1001)
# still work against the real backend via its own OTP demo mode (code 123456).
# Set to "true" only if you want the old fully-mocked, backend-less experience.
VITE_ENABLE_DEMO_AUTH=false

# Leave empty to use the simulated payment flow; set a real key to go live.
VITE_RAZORPAY_KEY=
