# Server
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins, e.g.
# CORS_ORIGIN=https://agesis.vercel.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Supabase (service role key — server-side only, NEVER expose to the frontend)
SUPABASE_URL=https://sklixbxqutkawaqoplok.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Razorpay (leave blank to run payments in simulated/demo mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (Nodemailer/SMTP — leave blank to log instead of sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AGESIS School <no-reply@agesisschool.edu>"

# SMS (Twilio — leave blank to log instead of sending)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
